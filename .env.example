# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Create a free account at https://clerk.com → create an application
# then copy your keys from Dashboard → API Keys

# Backend (Express)
CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Frontend (Vite) — must be the same publishable key, prefixed with VITE_
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Create a free cluster at https://mongodb.com/atlas
# Network Access → Add IP → Allow Access from Anywhere (0.0.0.0/0)
# Then copy your connection string

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Google Maps (optional) ───────────────────────────────────────────────────
# Only needed for the map and Places search features
# Create a key at https://console.cloud.google.com → APIs & Services → Credentials

VITE_GOOGLE_MAPS_API_KEY=AIzaSy_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
BASE_PATH=/
